    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. 獲取原始連結\nconst rawLink = $input.item.json.link || \"\";\n\nlet cleanUrl = rawLink;\n\nif (rawLink.includes(\"google.com/url\")) {\n  try {\n    // 解析 Google URL 中的參數\n    const parsedUrl = new URL(rawLink);\n    let targetUrl = parsedUrl.searchParams.get(\"url\");\n    \n    if (targetUrl) {\n      // 進行一次或多次解碼，防止 URL 被編碼成 %3A%2F%2F 導致 Firecrawl 無法辨識\n      cleanUrl = decodeURIComponent(targetUrl);\n    }\n  } catch (e) {\n    // 備用方案：正則表達式解析\n    const match = rawLink.match(/url=([^&]+)/);\n    if (match && match[1]) {\n      cleanUrl = decodeURIComponent(match[1]);\n    }\n  }\n}\n\n// 2. 確保網址是乾淨的純文字，並去掉前後空格\ncleanUrl = cleanUrl.trim();\n\n// 3. 輸出乾淨的網址給下一個 Firecrawl 節點\nreturn {\n  json: {\n    ...$input.item.json, \n    cleanUrl: cleanUrl    // 這個就是你要餵給 Firecrawl 的欄位\n  }\n};\n"
      },
      "name": "Get clean url",

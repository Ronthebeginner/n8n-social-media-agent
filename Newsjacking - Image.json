    {
      "parameters": {
        "jsCode": "const vision = $input.first().json.output;\n\nconst cleanSummary = vision.subject_summary.replace(/\\.+$/, '');\n\nconst final_prompt = `Hand-drawn illustration style, nostalgic 90s cel-shaded anime aesthetic, Ghibli-esque environment. ${cleanSummary}. Ambient scene in ${vision.dominant_palette} with soft, bright natural daylight. Fine paper stipple grain texture, soft organic colored-pencil linework, soft-focus painted background, minimalist composition, textless.`.trim();\n\nreturn {\n  final_prompt: final_prompt\n};"
      },
